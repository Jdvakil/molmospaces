<mujoco model="pact_collision_corridor">
  <compiler angle="radian" autolimits="true" boundmass="0" balanceinertia="true"/>
  <option impratio="10" gravity="0 0 -9.8" integrator="implicitfast" cone="elliptic" jacobian="sparse" noslip_iterations="4">
    <flag multiccd="enable" contact="enable" warmstart="enable"/>
  </option>
  <size njmax="6000" nconmax="6000"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <map znear="0.001"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.65 0.65 0.65"/>
  </visual>
  <asset>
    <texture name="benchtex" type="2d" builtin="flat" rgb1="0.85 0.86 0.88" width="32" height="32"/>
    <material name="bench" texture="benchtex" reflectance="0.1"/>
    <texture name="floortex" type="2d" builtin="checker" rgb1="0.46 0.46 0.48" rgb2="0.40 0.40 0.42" width="300" height="300"/>
    <material name="floormat" texture="floortex" texrepeat="10 10" reflectance="0.05"/>
  </asset>
  <default>
    <default class="hood">
      <geom contype="8" conaffinity="15" group="0" friction="0.9 0.9 0.001"
            solref="0.02 1" solimp="0.998 0.998 0.001" density="700"
            rgba="0.88 0.89 0.90 1"/>
    </default>
  </default>
  <worldbody>
    <light name="l_key" pos="0.4 0.5 2.6" dir="0 0 -1" diffuse="0.95 0.95 0.95"/>
    <light name="l_fill" pos="-0.6 -0.7 2.1" dir="0.3 0.3 -1" diffuse="0.5 0.5 0.5"/>
    <light name="l_hood" pos="0.85 0 1.55" dir="0 0 -1" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="floormat"
          contype="8" conaffinity="15"/>

    <geom name="room_wall_back" class="hood" type="box" pos="-2.0 0 1.4"
          size="0.05 2.05 1.4" rgba="0.82 0.83 0.85 1"/>
    <geom name="room_wall_front" class="hood" type="box" pos="2.4 0 1.4"
          size="0.05 2.05 1.4" rgba="0.82 0.83 0.85 1"/>
    <geom name="room_wall_left" class="hood" type="box" pos="0.2 2.0 1.4"
          size="2.25 0.05 1.4" rgba="0.80 0.81 0.84 1"/>
    <geom name="room_wall_right" class="hood" type="box" pos="0.2 -2.0 1.4"
          size="2.25 0.05 1.4" rgba="0.80 0.81 0.84 1"/>
    <geom name="room_ceiling" class="hood" type="box" pos="0.2 0 2.82"
          size="2.25 2.05 0.04" rgba="0.90 0.90 0.92 1"/>

    <geom name="bench_top" class="hood" type="box" pos="0.95 0 0.70"
          size="0.45 0.60 0.02" material="bench"/>
    <geom name="bench_body" class="hood" type="box" pos="0.95 0 0.35"
          size="0.42 0.57 0.33" rgba="0.80 0.81 0.83 1"/>
    <geom name="hood_side_l" class="hood" type="box" pos="0.95 0.45 1.12"
          size="0.40 0.012 0.40"/>
    <geom name="hood_side_r" class="hood" type="box" pos="0.95 -0.45 1.12"
          size="0.40 0.012 0.40"/>
    <geom name="hood_back" class="hood" type="box" pos="1.36 0 1.12"
          size="0.012 0.46 0.40"/>
    <geom name="hood_top" class="hood" type="box" pos="0.95 0 1.53"
          size="0.42 0.46 0.015"/>
    <geom name="hood_frame_l" class="hood" type="box" pos="0.58 0.45 1.12"
          size="0.02 0.02 0.40"/>
    <geom name="hood_frame_r" class="hood" type="box" pos="0.58 -0.45 1.12"
          size="0.02 0.02 0.40"/>

    <body name="sash" mocap="true" pos="0.58 0 1.30">
      <geom name="sash_g" class="hood" type="box" size="0.015 0.44 0.025"
            rgba="0.62 0.64 0.66 1"/>
    </body>
    <body name="jamb_l" mocap="true" pos="0.58 0.35 0.92">
      <geom name="jamb_l_g" class="hood" type="box" size="0.012 0.18 0.20"/>
    </body>
    <body name="jamb_r" mocap="true" pos="0.58 -0.35 0.92">
      <geom name="jamb_r_g" class="hood" type="box" size="0.012 0.18 0.20"/>
    </body>

    <!-- Legacy bars remain available because the inherited fumehood sampler parks
         them explicitly. They are never activated by the PACT corridor sampler. -->
    <body name="protr_s" mocap="true" pos="0 0.8 -2.0">
      <geom name="protr_s_g" class="hood" type="box" size="0.0175 0.0175 0.10"/>
    </body>
    <body name="protr_m" mocap="true" pos="0 1.2 -2.0">
      <geom name="protr_m_g" class="hood" type="box" size="0.025 0.025 0.11"/>
    </body>
    <body name="protr_l" mocap="true" pos="0 1.6 -2.0">
      <geom name="protr_l_g" class="hood" type="box" size="0.035 0.035 0.12"/>
    </body>

    <!-- Exactly one matte, wall-coloured lateral intrusion is activated per
         episode. It enters from the left or right outside the wrist camera's
         useful view and intersects the nominal wrist/link-6 passage. The opposite-side
         waypoint is physically open, so the scripted expert can solve either
         side without contact. -->
    <body name="pact_intrusion_left" mocap="true" pos="0 1.8 -2.0">
      <geom name="pact_intrusion_left_g" class="hood" type="box"
            size="0.120 0.240 0.080" rgba="0.88 0.89 0.90 1"/>
    </body>
    <body name="pact_intrusion_right" mocap="true" pos="0 -1.8 -2.0">
      <geom name="pact_intrusion_right_g" class="hood" type="box"
            size="0.120 0.240 0.080" rgba="0.88 0.89 0.90 1"/>
    </body>
  </worldbody>
</mujoco>
