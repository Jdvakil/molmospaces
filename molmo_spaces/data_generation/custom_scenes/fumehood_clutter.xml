<mujoco model="fumehood_clutter">
  <!-- fumehood.xml + a realistic cluttered lab bay + a rolling cart as the PLACE destination.

       Everything added here obeys one rule: no floating geometry. Every clutter item rests on a
       real surface that is itself part of the scene (shelf board, cabinet top, bench top, floor),
       so the depth the proximity skin reads is the depth a real SPAD would read in a real lab.

       Layout in world coords, robot pedestal centred near (0.08, 0), pedestal top z = 0.35:

                                  +y (robot's left)
                     shelf_unit  |  3 boards at z = 0.40 / 0.80 / 1.20, x 0.00..0.45
                                 |
         cabinet  ---------------+--------------- bench x 0.50..1.40, top z = 0.72
         x -0.75..-0.35          |               fume hood on top of it, mouth at x = 0.58
         top z = 0.85            |
                                 |  cart (PLACE TARGET) top z = 0.62, x 0.12..0.48
                                  -y (robot's right)

       The shelf unit, cabinet and cart are static: they give the skin a constant, structured
       return field on three sides at every arm height. The 16 mocap clutter items on top of them
       are re-posed per episode by ClutteredFumehoodPickPlaceSampler, so the field varies without
       ever recompiling the model.

       Reach check for the place target: cart top centre (0.30, -0.62, 0.62) is 0.71 m from the
       shoulder at (0.08, 0, 0.35); the FR3 reaches 0.855 m. -->
  <compiler angle="radian" autolimits="true" boundmass="0" balanceinertia="true"/>
  <option impratio="10" gravity="0 0 -9.8" integrator="implicitfast" cone="elliptic" jacobian="sparse" noslip_iterations="4">
    <flag multiccd="enable" contact="enable" warmstart="enable"/>
  </option>
  <size njmax="6000" nconmax="6000"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <map znear="0.001"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.65 0.65 0.65"/>
  </visual>
  <asset>
    <texture name="benchtex" type="2d" builtin="flat" rgb1="0.85 0.86 0.88" width="32" height="32"/>
    <material name="bench" texture="benchtex" reflectance="0.1"/>
    <texture name="floortex" type="2d" builtin="checker" rgb1="0.46 0.46 0.48" rgb2="0.40 0.40 0.42" width="300" height="300"/>
    <material name="floormat" texture="floortex" texrepeat="10 10" reflectance="0.05"/>
  </asset>
  <default>
    <default class="hood">
      <geom contype="8" conaffinity="15" group="0" friction="0.9 0.9 0.001"
            solref="0.02 1" solimp="0.998 0.998 0.001" density="700" rgba="0.92 0.93 0.94 1"/>
    </default>
    <!-- Clutter shares the hood contact class so the arm<->obstacle collision diagnostic in
         PickTask._accumulate_obstacle_diag counts a clutter strike exactly like a hazard-bar
         strike: it counts every penetrating contact with a non-robot, non-pickup, non-floor
         root body, and each clutter item is its own body. -->
    <default class="clutter">
      <geom contype="8" conaffinity="15" group="0" friction="0.9 0.9 0.001"
            solref="0.02 1" solimp="0.998 0.998 0.001" density="400"/>
    </default>
  </default>
  <worldbody>
    <light name="l_key" pos="0.4 0.5 2.6" dir="0 0 -1" diffuse="0.95 0.95 0.95"/>
    <light name="l_fill" pos="-0.6 -0.7 2.1" dir="0.3 0.3 -1" diffuse="0.5 0.5 0.5"/>
    <light name="l_hood" pos="0.85 0 1.55" dir="0 0 -1" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="floormat" contype="8" conaffinity="15"/>
    <!-- lab room shell ~2 m around the robot stance: guarantees every SPAD ray terminates on a
         surface instead of the no-return far plane. -->
    <geom name="room_wall_back"  class="hood" type="box" pos="-2.0 0 1.4"  size="0.05 2.05 1.4" rgba="0.82 0.83 0.85 1"/>
    <geom name="room_wall_front" class="hood" type="box" pos="2.4 0 1.4"   size="0.05 2.05 1.4" rgba="0.82 0.83 0.85 1"/>
    <geom name="room_wall_left"  class="hood" type="box" pos="0.2 2.0 1.4"  size="2.25 0.05 1.4" rgba="0.80 0.81 0.84 1"/>
    <geom name="room_wall_right" class="hood" type="box" pos="0.2 -2.0 1.4" size="2.25 0.05 1.4" rgba="0.80 0.81 0.84 1"/>
    <geom name="room_ceiling"    class="hood" type="box" pos="0.2 0 2.82"  size="2.25 2.05 0.04" rgba="0.90 0.90 0.92 1"/>
    <!-- lab bench: work surface z=0.72 -->
    <geom name="bench_top" class="hood" type="box" pos="0.95 0 0.70" size="0.45 0.60 0.02" material="bench"/>
    <geom name="bench_body" class="hood" type="box" pos="0.95 0 0.35" size="0.42 0.57 0.33" rgba="0.80 0.81 0.83 1"/>
    <!-- fumehood enclosure on the bench: side walls, back, top. FRONT = open, with a raised
         opaque sash RAIL (mocap) at the top of the opening. NO glass anywhere. -->
    <geom name="hood_side_l" class="hood" type="box" pos="0.95 0.45 1.12" size="0.40 0.012 0.40" rgba="0.90 0.91 0.92 1"/>
    <geom name="hood_side_r" class="hood" type="box" pos="0.95 -0.45 1.12" size="0.40 0.012 0.40" rgba="0.90 0.91 0.92 1"/>
    <geom name="hood_back"  class="hood" type="box" pos="1.36 0 1.12" size="0.012 0.46 0.40" rgba="0.88 0.89 0.90 1"/>
    <geom name="hood_top"   class="hood" type="box" pos="0.95 0 1.53" size="0.42 0.46 0.015"/>
    <geom name="hood_frame_l" class="hood" type="box" pos="0.58 0.45 1.12" size="0.02 0.02 0.40"/>
    <geom name="hood_frame_r" class="hood" type="box" pos="0.58 -0.45 1.12" size="0.02 0.02 0.40"/>

    <!-- ======================= LEFT: three-tier lab shelving unit =======================
         Boards at z = 0.40 / 0.80 / 1.20, spanning x 0.00..0.45, y 0.46..0.78. The near face
         sits at y = +0.46, roughly 0.21 m outside the arm's swept surface, which puts it in the
         middle of the skin's useful band (closeness 1 - 0.21/0.50 = 0.58) without ever being on
         the demonstrated path. The uprights give the side sensors vertical structure at every
         arm height instead of one flat wall. -->
    <geom name="shelf_up_a" class="hood" type="box" pos="0.02 0.48 0.68" size="0.02 0.02 0.68" rgba="0.55 0.57 0.60 1"/>
    <geom name="shelf_up_b" class="hood" type="box" pos="0.02 0.76 0.68" size="0.02 0.02 0.68" rgba="0.55 0.57 0.60 1"/>
    <geom name="shelf_up_c" class="hood" type="box" pos="0.43 0.48 0.68" size="0.02 0.02 0.68" rgba="0.55 0.57 0.60 1"/>
    <geom name="shelf_up_d" class="hood" type="box" pos="0.43 0.76 0.68" size="0.02 0.02 0.68" rgba="0.55 0.57 0.60 1"/>
    <geom name="shelf_board_0" class="hood" type="box" pos="0.225 0.62 0.39" size="0.225 0.16 0.01" rgba="0.86 0.87 0.89 1"/>
    <geom name="shelf_board_1" class="hood" type="box" pos="0.225 0.62 0.79" size="0.225 0.16 0.01" rgba="0.86 0.87 0.89 1"/>
    <geom name="shelf_board_2" class="hood" type="box" pos="0.225 0.62 1.19" size="0.225 0.16 0.01" rgba="0.86 0.87 0.89 1"/>

    <!-- ======================= REAR: floor cabinet =======================
         Front face at x = -0.35, about 0.18 m behind the arm's rearmost sweep. Its top at
         z = 0.85 carries clutter that the link1/link2 rear sensors see whenever J1 rotates. -->
    <geom name="cabinet_body" class="hood" type="box" pos="-0.55 0.0 0.42" size="0.20 0.35 0.42" rgba="0.78 0.79 0.81 1"/>
    <geom name="cabinet_top"  class="hood" type="box" pos="-0.55 0.0 0.845" size="0.21 0.36 0.015" rgba="0.70 0.71 0.74 1"/>

    <!-- ======================= RIGHT: rolling cart = THE PLACE DESTINATION =======================
         Top surface z = 0.62, centre (0.32, -0.56). The arm retrieves the object from inside the
         hood and sets it down here, so the transport leg is a wide lateral sweep right across the
         cluttered bay -- which is the whole point: the skin is loaded for the entire transport,
         not just at the grasp.

         The cart position is REACH-CONSTRAINED, not aesthetic. Measured from the shoulder at
         (0.08, 0, 0.35) against the FR3's 0.855 m reach: the first draft put the cart at
         (0.30, -0.62) and carried the object across at z = 1.00, which is 0.925 m out -- every
         episode failed with "IK failed, holding current position" on the transport leg. At
         (0.32, -0.56) the whole place sequence stays inside 0.80 m: over-cart at z = 0.78 is
         0.746 m, the release pose at z = 0.709 is 0.707 m. Move the cart and you must re-check
         both, plus CART_XY in tasks/fumehood_clutter.py. -->
    <geom name="cart_top"   class="hood" type="box" pos="0.32 -0.56 0.60" size="0.18 0.16 0.02" rgba="0.72 0.74 0.77 1"/>
    <geom name="cart_shelf" class="hood" type="box" pos="0.32 -0.56 0.28" size="0.17 0.15 0.015" rgba="0.72 0.74 0.77 1"/>
    <geom name="cart_leg_a" class="hood" type="box" pos="0.17 -0.42 0.29" size="0.015 0.015 0.29" rgba="0.45 0.46 0.49 1"/>
    <geom name="cart_leg_b" class="hood" type="box" pos="0.17 -0.70 0.29" size="0.015 0.015 0.29" rgba="0.45 0.46 0.49 1"/>
    <geom name="cart_leg_c" class="hood" type="box" pos="0.47 -0.42 0.29" size="0.015 0.015 0.29" rgba="0.45 0.46 0.49 1"/>
    <geom name="cart_leg_d" class="hood" type="box" pos="0.47 -0.70 0.29" size="0.015 0.015 0.29" rgba="0.45 0.46 0.49 1"/>

    <!-- SASH RAIL (opaque aluminium, sash raised): bottom edge = opening height. -->
    <body name="sash" mocap="true" pos="0.58 0 1.30">
      <geom name="sash_g" class="hood" type="box" size="0.015 0.44 0.025" rgba="0.62 0.64 0.66 1"/>
    </body>
    <!-- side jambs: mocap, set opening WIDTH -->
    <body name="jamb_l" mocap="true" pos="0.58 0.35 0.92">
      <geom name="jamb_l_g" class="hood" type="box" size="0.012 0.18 0.20" rgba="0.88 0.89 0.90 1"/>
    </body>
    <body name="jamb_r" mocap="true" pos="0.58 -0.35 0.92">
      <geom name="jamb_r_g" class="hood" type="box" size="0.012 0.18 0.20" rgba="0.88 0.89 0.90 1"/>
    </body>
    <!-- in-hood hazard bars: the existing obstacle mechanism, unchanged. One of these is the
         bar that ObstacleFumehoodPickSampler places beside the approach corridor, and that
         InvisibleObstacleFumehoodPickSampler can move to geom group 4 to hide from RGB. -->
    <body name="protr_s" mocap="true" pos="0 0.8 -2.0">
      <geom name="protr_s_g" class="hood" type="box" size="0.0175 0.0175 0.10" rgba="0.55 0.6 0.65 1"/>
    </body>
    <body name="protr_m" mocap="true" pos="0 1.2 -2.0">
      <geom name="protr_m_g" class="hood" type="box" size="0.025 0.025 0.11" rgba="0.5 0.55 0.6 1"/>
    </body>
    <body name="protr_l" mocap="true" pos="0 1.6 -2.0">
      <geom name="protr_l_g" class="hood" type="box" size="0.035 0.035 0.12" rgba="0.45 0.5 0.55 1"/>
    </body>

    <!-- ======================= MOCAP CLUTTER (16 items) =======================
         Parked at z = -2.0 and re-posed each episode by the sampler, which pins each item's z to
         (surface height + its own half-height) so nothing ever floats. Half-extents here must
         stay in sync with CLUTTER_ITEMS in molmo_spaces/tasks/fumehood_clutter.py -- the sampler
         reads that table to compute rest heights and obstacle AABBs.

         SHELF items: amber reagent bottles, r=0.045 half_z=0.10, on the three shelf boards. -->
    <body name="clut_sh0" mocap="true" pos="0 3.0 -2.0">
      <geom name="clut_sh0_g" class="clutter" type="cylinder" size="0.045 0.10" rgba="0.55 0.35 0.12 1"/>
    </body>
    <body name="clut_sh1" mocap="true" pos="0 3.2 -2.0">
      <geom name="clut_sh1_g" class="clutter" type="cylinder" size="0.045 0.10" rgba="0.62 0.42 0.15 1"/>
    </body>
    <body name="clut_sh2" mocap="true" pos="0 3.4 -2.0">
      <geom name="clut_sh2_g" class="clutter" type="cylinder" size="0.045 0.10" rgba="0.30 0.42 0.30 1"/>
    </body>
    <body name="clut_sh3" mocap="true" pos="0 3.6 -2.0">
      <geom name="clut_sh3_g" class="clutter" type="cylinder" size="0.045 0.10" rgba="0.85 0.86 0.88 1"/>
    </body>
    <body name="clut_sh4" mocap="true" pos="0 3.8 -2.0">
      <geom name="clut_sh4_g" class="clutter" type="cylinder" size="0.045 0.10" rgba="0.48 0.30 0.10 1"/>
    </body>
    <!-- HOOD items: smaller bottles/beakers standing on the bench inside the fume hood,
         either deep behind the pick target or beside the corridor when the jambs leave room. -->
    <body name="clut_hd0" mocap="true" pos="0 4.0 -2.0">
      <geom name="clut_hd0_g" class="clutter" type="cylinder" size="0.040 0.085" rgba="0.58 0.38 0.14 1"/>
    </body>
    <body name="clut_hd1" mocap="true" pos="0 4.2 -2.0">
      <geom name="clut_hd1_g" class="clutter" type="cylinder" size="0.040 0.085" rgba="0.80 0.82 0.84 1"/>
    </body>
    <body name="clut_hd2" mocap="true" pos="0 4.4 -2.0">
      <geom name="clut_hd2_g" class="clutter" type="cylinder" size="0.040 0.085" rgba="0.35 0.45 0.55 1"/>
    </body>
    <body name="clut_hd3" mocap="true" pos="0 4.6 -2.0">
      <geom name="clut_hd3_g" class="clutter" type="cylinder" size="0.040 0.085" rgba="0.60 0.40 0.16 1"/>
    </body>
    <!-- CABINET items: stacked supply boxes on the rear cabinet top. -->
    <body name="clut_cb0" mocap="true" pos="0 4.8 -2.0">
      <geom name="clut_cb0_g" class="clutter" type="box" size="0.08 0.06 0.10" rgba="0.76 0.70 0.58 1"/>
    </body>
    <body name="clut_cb1" mocap="true" pos="0 5.0 -2.0">
      <geom name="clut_cb1_g" class="clutter" type="box" size="0.08 0.06 0.10" rgba="0.70 0.72 0.75 1"/>
    </body>
    <body name="clut_cb2" mocap="true" pos="0 5.2 -2.0">
      <geom name="clut_cb2_g" class="clutter" type="box" size="0.08 0.06 0.10" rgba="0.66 0.60 0.52 1"/>
    </body>
    <!-- FLOOR items: solvent drums standing on the lab floor around the pedestal. -->
    <body name="clut_fl0" mocap="true" pos="0 5.4 -2.0">
      <geom name="clut_fl0_g" class="clutter" type="cylinder" size="0.11 0.28" rgba="0.25 0.35 0.55 1"/>
    </body>
    <body name="clut_fl1" mocap="true" pos="0 5.6 -2.0">
      <geom name="clut_fl1_g" class="clutter" type="cylinder" size="0.11 0.28" rgba="0.30 0.30 0.32 1"/>
    </body>
    <!-- Two of the four floor items are full-height gas cylinders rather than drums. Drums top
         out at 0.56, below the arm's working height, so their return is dominated by the vertical
         gap; a cylinder standing 1.30 tall presents a surface across the whole span the arm
         actually occupies, which is what puts the mid-arm sensors in their useful band. -->
    <body name="clut_fl2" mocap="true" pos="0 5.8 -2.0">
      <geom name="clut_fl2_g" class="clutter" type="cylinder" size="0.09 0.65" rgba="0.55 0.52 0.20 1"/>
    </body>
    <body name="clut_fl3" mocap="true" pos="0 6.0 -2.0">
      <geom name="clut_fl3_g" class="clutter" type="cylinder" size="0.09 0.65" rgba="0.22 0.40 0.35 1"/>
    </body>
  </worldbody>
</mujoco>
