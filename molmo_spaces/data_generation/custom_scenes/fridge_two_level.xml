<mujoco model="fridge_two_level">
  <compiler angle="radian" autolimits="true" boundmass="0" balanceinertia="true"/>
  <option impratio="10" gravity="0 0 -9.8" integrator="implicitfast" cone="elliptic" jacobian="sparse" noslip_iterations="4">
    <flag multiccd="enable" contact="enable" warmstart="enable"/>
  </option>
  <size njmax="5000" nconmax="5000"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <map znear="0.001"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.6 0.6 0.6"/>
  </visual>
  <default>
    <default class="cavity_struct">
      <geom contype="8" conaffinity="15" group="0" friction="0.9 0.9 0.001"
            solref="0.02 1" solimp="0.998 0.998 0.001" density="800" rgba="0.72 0.75 0.76 1"/>
    </default>
  </default>
  <worldbody>
    <light pos="0.5 0.5 3" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" rgba="0.3 0.3 0.34 1"/>

    <body name="fridge" pos="0 0 0">
      <geom name="cab_floor" class="cavity_struct" type="box" pos="0.60 0 0.38" size="0.26 0.32 0.02"/>
      <geom name="cab_mid"   class="cavity_struct" type="box" pos="0.60 0 0.78" size="0.26 0.32 0.02"/>
      <geom name="cab_top"   class="cavity_struct" type="box" pos="0.60 0 1.12" size="0.26 0.32 0.02"/>
      <geom name="cab_back"  class="cavity_struct" type="box" pos="0.85 0 0.75" size="0.02 0.32 0.39"/>
      <geom name="cab_left"  class="cavity_struct" type="box" pos="0.60 0.31 0.75" size="0.26 0.02 0.39"/>
      <geom name="cab_right" class="cavity_struct" type="box" pos="0.60 -0.31 0.75" size="0.26 0.02 0.39"/>
      <geom name="cab_lower_lip" class="cavity_struct" type="box" pos="0.34 0 0.42" size="0.02 0.32 0.02"/>
      <geom name="upper_pick_stand" class="cavity_struct" type="box" pos="0.45 0 0.815" size="0.025 0.025 0.015"/>
    </body>

    <body name="place_pad" pos="0.45 0 0.50">
      <geom name="place_pad" type="box" size="0.12 0.12 0.02"
            rgba="0.2 0.7 0.2 1" contype="8" conaffinity="15" group="0"
            friction="1.0 0.9 0.001" solref="0.02 1" solimp="0.998 0.998 0.001" density="800"/>
    </body>
  </worldbody>
</mujoco>
